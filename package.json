{
  "name": "souschef",
  "version": "0.2.0",
  "description": "MCP server and Claude Code plugin that delegates test writing to a second coding agent (Antigravity CLI first) in an isolated workspace, verifies the result and returns a compact report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "souschef": "plugin/dist/server.cjs"
  },
  "files": [
    "plugin/dist/server.cjs"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "esbuild src/mcp/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=plugin/dist/server.cjs --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "build:tests": "tsc -p tsconfig.tests.json",
    "test": "npm run build:tests && node --test --test-concurrency=1 \"build-tests/tests/unit/*.test.js\" \"build-tests/tests/integration/*.test.js\"",
    "test:e2e": "npm run build && node scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "picomatch": "4.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "main": "plugin/dist/server.cjs"
}
